# Copy to .env.local for local development.
# Both Supabase values are public by design: they ship to the browser. Row
# Level Security on the leads table is what keeps submitted leads private.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set by the GitHub Pages workflow. Leave empty locally or on a custom domain.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
